#!/usr/bin/env python3
"""Deauthenticate one unicast client on wlan0.

Root owns the installed copy. The pideck-deauth account may run it through
sudo with one MAC argument and no other command. This program does not start
a shell, and it refuses a broadcast or multicast address.
"""

from __future__ import annotations

import os
import re
import sys

HOSTAPD_CLI = "/usr/sbin/hostapd_cli"
_MAC = re.compile(r"^[0-9a-f]{2}(?::[0-9a-f]{2}){5}$")


def command_args(raw: str) -> list[str] | None:
    if not isinstance(raw, str) or raw != raw.strip() or any(char.isspace() for char in raw):
        return None
    mac = raw.lower().replace("-", ":")
    if mac != raw or _MAC.fullmatch(mac) is None:
        return None
    if int(mac[:2], 16) & 1:
        return None
    return [HOSTAPD_CLI, "-i", "wlan0", "deauthenticate", mac]


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv if argv is None else argv)
    if len(args) != 2:
        print("Refusing a disconnect request that is not one client.", file=sys.stderr)
        return 2
    command = command_args(args[1])
    if command is None:
        print("Refusing a MAC address that is not one unicast client.", file=sys.stderr)
        return 2
    try:
        os.execv(command[0], command)
    except OSError:
        print("hostapd control is unavailable.", file=sys.stderr)
        return 1
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
