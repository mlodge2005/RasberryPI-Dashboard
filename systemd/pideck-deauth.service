[Unit]
Description=PiDeck hotspot disconnect helper
After=network.target
Requires=pideck-deauth.socket

[Service]
Type=simple
User=pideck-deauth
Group=pideck-deauth
WorkingDirectory=/var/lib/pideck-deauth
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=__APP_DIR__
Environment=PYTHONSAFEPATH=1
ExecStart=__APP_DIR__/backend/.venv/bin/python -m backend.deauth_helper
Restart=on-failure
RestartSec=1
# NoNewPrivileges is omitted so sudo can run the one disconnect program.
# sudoers/pideck-deauth allows only that program, with one MAC address.
# PrivateTmp must stay off. The disconnect program execs hostapd_cli, which
# binds its control client socket in the host /tmp. hostapd replies there.
# ProtectSystem=strict also mounts that /tmp read-only, so the socket path
# has to be listed in ReadWritePaths.
PrivateTmp=no
ProtectSystem=strict
ReadWritePaths=/tmp
InaccessiblePaths=/etc/pideck /var/lib/pideck
UMask=0077

[Install]
WantedBy=multi-user.target
