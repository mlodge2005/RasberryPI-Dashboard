[Unit]
Description=PiDeck upstream Wi-Fi helper
After=network.target dbus.service NetworkManager.service
Requires=pideck-wifi.socket

[Service]
Type=simple
User=pideck-wifi
Group=pideck-wifi
WorkingDirectory=/var/lib/pideck-wifi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=__APP_DIR__
Environment=PYTHONSAFEPATH=1
ExecStart=__APP_DIR__/backend/.venv/bin/python -m backend.wifi_helper
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
