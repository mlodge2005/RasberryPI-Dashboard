[Unit]
Description=PiDeck Raspberry Pi dashboard
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
Group=__GROUP__
SupplementaryGroups=gpio
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=session_secret:/etc/pideck/session.secret
ExecStart=__APP_DIR__/backend/.venv/bin/python -m backend
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
PrivateTmp=yes
ReadWritePaths=__APP_DIR__/data
UMask=0077

[Install]
WantedBy=multi-user.target
