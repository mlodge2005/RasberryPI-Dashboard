# Copy to .env and replace the session secret before starting PiDeck on a laptop.
# On the Raspberry Pi, do not put the session secret in this file.
# install.sh and migrate-privileges.sh store it in /etc/pideck/session.secret
# and systemd passes it as a credential named session_secret.
# Generate a development secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

PIDECK_HOST=127.0.0.1
PIDECK_PORT=8080
PIDECK_DATABASE=./data/pideck.db
PIDECK_SESSION_SECRET=replace-with-a-long-random-string
PIDECK_SESSION_HOURS=24

# auto: Secure cookies when X-Forwarded-Proto is https (Tailscale Serve and the hotspot proxy).
# true: always Secure (use behind HTTPS).
# false: never Secure (plain http://127.0.0.1 during local development).
PIDECK_COOKIE_SECURE=auto

# true enables an ephemeral session secret if the placeholder above is unchanged,
# and allows the Vite dev origin and a local PTY when the terminal helper is absent.
# Leave false on the Raspberry Pi.
PIDECK_DEV=false

# Keep false. PiDeck refuses to bind anything except localhost unless this is true.
PIDECK_ALLOW_NON_LOCALHOST=false

# Production connects to the pideck-term helper here.
PIDECK_TERMINAL_SOCKET=/run/pideck/terminal.sock

# Production connects to the pideck-wifi helper here. That helper controls wlan1 only.
PIDECK_WIFI_SOCKET=/run/pideck/wifi.sock
