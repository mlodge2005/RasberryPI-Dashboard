# Copy to .env and replace the session secret before starting PiDeck.
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

PIDECK_HOST=127.0.0.1
PIDECK_PORT=8080
PIDECK_DATABASE=./data/pideck.db
PIDECK_SESSION_SECRET=replace-with-a-long-random-string
PIDECK_SESSION_HOURS=24

# auto: Secure cookies when X-Forwarded-Proto is https (Tailscale Serve).
# true: always Secure (use behind HTTPS).
# false: never Secure (plain http://127.0.0.1 during local development).
PIDECK_COOKIE_SECURE=auto

# true enables an ephemeral session secret if the placeholder above is unchanged,
# and allows the Vite dev origin. Leave false on the Raspberry Pi.
PIDECK_DEV=false

# Keep false. PiDeck refuses to bind anything except localhost unless this is true.
PIDECK_ALLOW_NON_LOCALHOST=false
